---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/seo/SEO.astro';
import BlogBreadcrumb from '../components/blog/BlogBreadcrumb.astro';
import StudentForm from '../components/forms/StudentForm.astro';

const pageTitle = 'Para Estudantes | Instituto Recomeçar';
const pageDescription =
  'Estudantes e pesquisadores podem desenvolver trabalhos acadêmicos junto ao Instituto Recomeçar. Conheça os pilares e envie sua proposta.';

const pillars = [
  {
    title: 'Reintegração Social',
    description:
      'Apoio a pesquisas e estudos que aprofundem o entendimento sobre a reinserção de egressos do sistema prisional na sociedade.',
  },
  {
    title: 'Qualificação',
    description:
      'Espaço para trabalhos acadêmicos sobre educação profissional, empregabilidade e desenvolvimento de competências.',
  },
  {
    title: 'Transformação de Vidas',
    description:
      'Incentivo a projetos que documentem e analisem o impacto social da metodologia do Instituto Recomeçar.',
  },
];
---

<BaseLayout>
  <SEO
    slot="head"
    title={pageTitle}
    description={pageDescription}
    canonicalPath="/para-estudantes/"
    breadcrumbs={[{ label: 'Para Estudantes' }]}
  />

  <div class="page">
    <BlogBreadcrumb
      items={[
        { label: 'Início', href: '/' },
        { label: 'Para Estudantes', current: true },
      ]}
    />

    <header class="page__header">
      <p class="page__eyebrow">Pesquisa e formação</p>
      <h1 class="page__title">Para Estudantes</h1>
      <p class="page__lead">
        O Instituto Recomeçar abre espaço para estudantes e pesquisadores interessados em desenvolver
        trabalhos acadêmicos alinhados à nossa missão de ressocialização.
      </p>
    </header>

    <section class="pillars" aria-label="Pilares de atuação">
      <ul class="pillars__grid">
        {
          pillars.map((pillar) => (
            <li class="pillar-card">
              <h2 class="pillar-card__title">{pillar.title}</h2>
              <p class="pillar-card__text">{pillar.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="form-section" aria-label="Formulário para estudantes">
      <h2 class="form-section__title">Envie sua proposta</h2>
      <div class="form-panel">
        <StudentForm />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    width: min(100% - 3rem, var(--container-max));
    margin-inline: auto;
    padding: 3rem 0 5rem;
  }

  .page__header {
    max-width: 42rem;
    margin-bottom: 2.5rem;
  }

  .page__eyebrow {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .page__title {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-primary);
  }

  .page__lead,
  .form-section__lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted-text);
  }

  .pillars {
    margin-bottom: 3.5rem;
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pillar-card {
    padding: 1.5rem;
    background-color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .pillar-card__title {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .pillar-card__text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted-text);
  }

  .form-section__title {
    margin-bottom: 0.75rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-primary);
  }

  .form-section__lead {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .form-panel {
    padding: 1.5rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (min-width: 768px) {
    .pillars__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
