---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/seo/SEO.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import ArticleImage from '../../components/blog/ArticleImage.astro';
import BlogBreadcrumb from '../../components/blog/BlogBreadcrumb.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import JoinAdsScript from '../../components/ads/JoinAdsScript.astro';
import {
  formatArticleDate,
  getArticleSeoDescription,
  getArticleSeoTitle,
  getClusterContext,
  getPublishedArticles,
  getReadingTimeMinutes,
  getRelatedArticles,
  type ArticleEntry,
  type ClusterContext,
} from '../../lib/blog';
import { resolveArticleImageWithFallback } from '../../lib/blog-image';
import { getAuthor } from '../../lib/authors';
import { SITE_URL, authorJsonLd, organizationRef } from '../../lib/jsonld';
import { toPlainText } from '../../lib/seo';

export async function getStaticPaths() {
  const allArticles = await getPublishedArticles();

  return allArticles.map((article) => ({
    params: { slug: article.data.slug },
    props: {
      article,
      relatedArticles: getRelatedArticles(article, allArticles),
      clusterContext: getClusterContext(article, allArticles),
    },
  }));
}

interface Props {
  article: ArticleEntry;
  relatedArticles: ArticleEntry[];
  clusterContext?: ClusterContext;
}

const { article, relatedArticles, clusterContext } = Astro.props;
const { Content } = await render(article);

const seoTitle = getArticleSeoTitle(article);
const seoDescription = getArticleSeoDescription(article);
const canonicalPath = `/blog/${article.data.slug}/`;
const author = getAuthor(article.data.author);
// Bio: do cadastro do autor ou, para colunistas, do perfil em src/content/colunistas.
const authorColunista = author?.colunista
  ? await getEntry('colunistas', author.colunista)
  : undefined;
const authorBio = author?.bio ?? authorColunista?.data.bio;
const readingMinutes = getReadingTimeMinutes(article.body ?? '');
const coverImage = await resolveArticleImageWithFallback(
  article.data.image,
  article.data.title,
  1200,
  630,
);

const coverImageUrl = coverImage.isRemote
  ? coverImage.src
  : new URL(coverImage.src, SITE_URL).href;

// SVG (capa provisória) não é formato de imagem aceito em rich results de artigo.
const schemaImageUrl = /\.svg(\?|$)/i.test(coverImageUrl)
  ? new URL('/images/og-default.png', SITE_URL).href
  : coverImageUrl;

const articleUrl = new URL(canonicalPath, SITE_URL).href;

// Mesmos itens para o breadcrumb visual e para o BreadcrumbList do schema.
const breadcrumbItems = [
  { label: 'Início', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: article.data.title, current: true },
];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: toPlainText(article.data.title),
  description: seoDescription,
  image: schemaImageUrl,
  datePublished: article.data.pubDate.toISOString(),
  // dateModified só existe quando há uma data de revisão real no artigo.
  ...(article.data.updatedDate && { dateModified: article.data.updatedDate.toISOString() }),
  inLanguage: 'pt-BR',
  url: articleUrl,
  // Autor individual quando cadastrado no artigo; sem autor, a organização assina.
  author: author ? authorJsonLd({ ...author, bio: authorBio }) : organizationRef(),
  publisher: {
    ...organizationRef(),
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/logo-recomecar.png`,
    },
  },
  isPartOf: {
    '@type': 'Blog',
    name: 'Blog Recomeçar',
    url: new URL('/blog/', SITE_URL).href,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
};
---

<BaseLayout>
  <SEO
    slot="head"
    title={seoTitle}
    description={seoDescription}
    canonicalPath={canonicalPath}
    ogImage={schemaImageUrl}
    jsonLd={[articleJsonLd]}
    breadcrumbs={breadcrumbItems}
  />
  <JoinAdsScript slot="head" />

  <article class="post">
    <header class="post__header">
      <BlogBreadcrumb items={breadcrumbItems} />

      <h1 class="post__title">{article.data.title}</h1>
      <div class="post__meta">
        {
          author && (
            <>
              <span class="post__author">
                Por {author.path ? <a href={author.path}>{author.name}</a> : author.name}
              </span>
              <span aria-hidden="true">·</span>
            </>
          )
        }
        <time datetime={article.data.pubDate.toISOString()}>
          {formatArticleDate(article.data.pubDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min de leitura</span>
      </div>

      <ArticleImage
        imagePath={article.data.image}
        alt={article.data.title}
        width={1200}
        height={630}
        class="post__cover"
        loading="eager"
        fetchpriority="high"
      />
    </header>

    <div class="post__content">
      <AdSlot code="Content3" />
      <Content />
    </div>

    {
      clusterContext && (clusterContext.pillar || clusterContext.spokes.length > 0) && (
        <aside class="post__cluster" aria-label={`Tema: ${clusterContext.label}`}>
          <p class="post__cluster-label">Tema: {clusterContext.label}</p>
          {clusterContext.pillar && (
            <p class="post__cluster-text">
              Quer o panorama completo? Leia o guia{' '}
              <a href={`/blog/${clusterContext.pillar.slug}/`}>{clusterContext.pillar.title}</a>.
            </p>
          )}
          {clusterContext.spokes.length > 0 && (
            <>
              <p class="post__cluster-text">Continue lendo sobre este tema:</p>
              <ul class="post__cluster-list">
                {clusterContext.spokes.map((spoke) => (
                  <li>
                    <a href={`/blog/${spoke.slug}/`}>{spoke.title}</a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </aside>
      )
    }

    {
      author && authorBio && (
        <aside class="post__author-box" aria-label="Sobre o autor">
          <p class="post__author-box-label">Sobre o autor</p>
          <p class="post__author-box-name">
            {author.path ? <a href={author.path}>{author.name}</a> : author.name}
          </p>
          <p class="post__author-box-bio">{authorBio}</p>
        </aside>
      )
    }

    <aside class="post__ad-end" aria-label="Publicidade">
      <AdSlot code="Content4" />
    </aside>

    {
      relatedArticles.length > 0 && (
        <section class="post__related" aria-label="Artigos relacionados">
          <h2 class="post__related-title">Artigos relacionados</h2>
          <ul class="post__related-grid">
            {relatedArticles.map((related) => (
              <li>
                <ArticleCard article={related} headingLevel="h3" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="post__footer">
      <a href="/blog/" class="post__back">← Voltar ao blog</a>
    </footer>
  </article>

  {/* JoinAds cria o Fixed sticky + botão fechar; não envolver em UI própria. */}
  <AdSlot code="Fixed" refresh={true} lazyload={false} />
</BaseLayout>

<style>
  .post {
    width: min(100% - 3rem, var(--container-max));
    margin-inline: auto;
    padding: 2.5rem 0 5rem;
  }

  .post__header {
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: 2rem;
  }

  .post__cluster {
    max-width: 48rem;
    margin: 2rem auto 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border, #e5e7eb);
    border-left: 4px solid var(--color-accent-text, #0f766e);
    border-radius: 0.5rem;
    background: var(--color-surface, #f9fafb);
  }

  .post__cluster p {
    margin: 0 0 0.5rem;
  }

  .post__cluster-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-text, #0f766e);
  }

  .post__cluster-text {
    font-size: 1rem;
    line-height: 1.6;
  }

  .post__cluster a {
    font-weight: 600;
    text-decoration: underline;
  }

  .post__cluster-list {
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.7;
  }

  .post__author-box {
    max-width: 48rem;
    margin: 2.5rem auto 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-muted);
  }

  .post__author-box p {
    margin: 0;
  }

  .post__author-box-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted-text);
  }

  .post__author-box-name {
    margin-top: 0.25rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .post__author-box-name a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .post__author-box-bio {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .post__author a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .post__author a:hover,
  .post__author a:focus-visible {
    text-decoration-thickness: 2px;
  }

  .post__title {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-muted-text);
  }

  .post__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .post__content {
    max-width: 48rem;
    margin-inline: auto;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .post__ad-end {
    max-width: 48rem;
    margin: 2rem auto 0;
  }

  .post__content :global(h2),
  .post__content :global(h3),
  .post__content :global(h4) {
    margin: 2rem 0 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-primary);
  }

  .post__content :global(h2) {
    font-size: 1.5rem;
  }

  .post__content :global(h3) {
    font-size: 1.25rem;
  }

  .post__content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post__content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post__content :global(a:hover),
  .post__content :global(a:focus-visible) {
    color: var(--color-primary-hover);
  }

  .post__content :global(ul),
  .post__content :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
  }

  .post__content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post__content :global(img) {
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border-radius: var(--radius-sm);
  }

  .post__content :global(strong) {
    font-weight: 700;
  }

  .post__content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-accent);
    background-color: var(--color-muted);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .post__content :global(figure.wp-block-table),
  .post__content :global(.table-wrap) {
    margin: 1.75rem 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .post__content :global(table) {
    width: 100%;
    min-width: 36rem;
    margin: 1.75rem 0;
    border-collapse: collapse;
    border: 1px solid var(--color-border);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-align: left;
    background-color: var(--color-bg);
  }

  .post__content :global(figure.wp-block-table table) {
    margin: 0;
  }

  .post__content :global(caption) {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted-text);
    text-align: left;
  }

  .post__content :global(th),
  .post__content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    vertical-align: top;
    word-break: normal;
    overflow-wrap: break-word;
  }

  .post__content :global(th) {
    font-weight: 700;
    color: var(--color-foreground);
    background-color: var(--color-muted);
    white-space: nowrap;
  }

  .post__content :global(tbody tr:nth-child(even) td) {
    background-color: color-mix(in srgb, var(--color-muted) 55%, transparent);
  }

  .post__related {
    max-width: var(--container-max);
    margin: 4rem auto 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .post__related-title {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .post__related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: stretch;
  }

  .post__related-grid > li {
    display: flex;
    height: 100%;
  }

  .post__related-grid > li > :global(*) {
    width: 100%;
  }

  .post__footer {
    max-width: 48rem;
    margin: 3rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .post__back {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .post__back:hover,
  .post__back:focus-visible {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .post__related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .post__related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
