---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/seo/SEO.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import ArticleImage from '../../components/blog/ArticleImage.astro';
import BlogBreadcrumb from '../../components/blog/BlogBreadcrumb.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import JoinAdsScript from '../../components/ads/JoinAdsScript.astro';
import {
  formatArticleDate,
  getArticleSeoDescription,
  getArticleSeoTitle,
  getPublishedArticles,
  getReadingTimeMinutes,
  getRelatedArticles,
  type ArticleEntry,
} from '../../lib/blog';
import { resolveArticleImageWithFallback } from '../../lib/blog-image';
import { categoryToSlug, getCategoryLabel } from '../../lib/categories';
import { SITE_URL } from '../../lib/jsonld';

export async function getStaticPaths() {
  const allArticles = await getPublishedArticles();

  return allArticles.map((article) => ({
    params: { slug: article.data.slug },
    props: {
      article,
      relatedArticles: getRelatedArticles(article, allArticles),
    },
  }));
}

interface Props {
  article: ArticleEntry;
  relatedArticles: ArticleEntry[];
}

const { article, relatedArticles } = Astro.props;
const { Content } = await render(article);

const seoTitle = getArticleSeoTitle(article);
const seoDescription = getArticleSeoDescription(article);
const canonicalPath = `/blog/${article.data.slug}/`;
const categorySlug = categoryToSlug(article.data.category);
const categoryLabel = getCategoryLabel(categorySlug);
const readingMinutes = getReadingTimeMinutes(article.body ?? '');
const coverImage = await resolveArticleImageWithFallback(
  article.data.image,
  article.data.title,
  1200,
  630,
);

const coverImageUrl = coverImage.isRemote
  ? coverImage.src
  : new URL(coverImage.src, SITE_URL).href;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: seoDescription,
  image: coverImageUrl,
  datePublished: article.data.pubDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Instituto Recomeçar',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Instituto Recomeçar',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/logo-recomecar.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(canonicalPath, SITE_URL).href,
  },
};
---

<BaseLayout>
  <SEO
    slot="head"
    title={seoTitle}
    description={seoDescription}
    canonicalPath={canonicalPath}
    jsonLd={[articleJsonLd]}
  />
  <JoinAdsScript slot="head" />

  <article class="post">
    <header class="post__header">
      <BlogBreadcrumb
        items={[
          { label: 'Início', href: '/' },
          { label: 'Blog', href: '/blog/' },
          { label: categoryLabel, href: `/blog/categoria/${categorySlug}/` },
          { label: article.data.title, current: true },
        ]}
      />

      <a href={`/blog/categoria/${categorySlug}/`} class="post__category">
        {categoryLabel}
      </a>
      <h1 class="post__title">{article.data.title}</h1>
      <div class="post__meta">
        <time datetime={article.data.pubDate.toISOString()}>
          {formatArticleDate(article.data.pubDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min de leitura</span>
      </div>

      <ArticleImage
        imagePath={article.data.image}
        alt={article.data.title}
        width={1200}
        height={630}
        class="post__cover"
        loading="eager"
        fetchpriority="high"
      />
    </header>

    <div class="post__content">
      <AdSlot code="Content3" />
      <Content />
    </div>

    <aside class="post__ad-end" aria-label="Publicidade">
      <AdSlot code="Content4" />
    </aside>

    {
      relatedArticles.length > 0 && (
        <section class="post__related" aria-label="Artigos relacionados">
          <h2 class="post__related-title">Artigos relacionados</h2>
          <ul class="post__related-grid">
            {relatedArticles.map((related) => (
              <li>
                <ArticleCard article={related} headingLevel="h3" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="post__footer">
      <a href="/blog/" class="post__back">← Voltar ao blog</a>
    </footer>
  </article>

  <div class="ad-fixed-wrap">
    <input type="checkbox" id="close-ad-fixed" class="ad-fixed__toggle" />
    <div class="ad-fixed" role="complementary" aria-label="Publicidade fixa">
      <label for="close-ad-fixed" class="ad-fixed__close" aria-label="Fechar anúncio">
        ✕
      </label>
      <AdSlot code="Fixed" refresh={true} lazyload={false} />
    </div>
  </div>
</BaseLayout>

<style>
  .post {
    width: min(100% - 3rem, var(--container-max));
    margin-inline: auto;
    padding: 2.5rem 0 8rem;
  }

  .post__header {
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: 2rem;
  }

  .post__category {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    text-decoration: none;
  }

  .post__category:hover,
  .post__category:focus-visible {
    text-decoration: underline;
  }

  .post__title {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-muted-text);
  }

  .post__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .post__content {
    max-width: 48rem;
    margin-inline: auto;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .post__content :global(> .ad-slot) {
    margin-bottom: 1.75rem;
  }

  .post__ad-end {
    max-width: 48rem;
    margin: 2rem auto 0;
  }

  .ad-fixed-wrap {
    position: relative;
  }

  .ad-fixed__toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ad-fixed {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 2.5rem 0.5rem 0.75rem;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -4px 20px rgb(0 0 0 / 10%);
  }

  .ad-fixed__close {
    position: absolute;
    top: 0.35rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    font-size: 0.875rem;
    line-height: 1;
    color: var(--color-muted-text);
    cursor: pointer;
    border-radius: var(--radius-sm);
    background-color: var(--color-muted);
  }

  .ad-fixed__close:hover,
  .ad-fixed__close:focus-visible {
    color: var(--color-text);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .ad-fixed__toggle:checked + .ad-fixed {
    display: none;
  }

  .ad-fixed :global(.ad-slot) {
    width: min(100%, 48rem);
  }

  .post__content :global(h2),
  .post__content :global(h3),
  .post__content :global(h4) {
    margin: 2rem 0 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-primary);
  }

  .post__content :global(h2) {
    font-size: 1.5rem;
  }

  .post__content :global(h3) {
    font-size: 1.25rem;
  }

  .post__content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post__content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post__content :global(a:hover),
  .post__content :global(a:focus-visible) {
    color: var(--color-primary-hover);
  }

  .post__content :global(ul),
  .post__content :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
  }

  .post__content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post__content :global(img) {
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border-radius: var(--radius-sm);
  }

  .post__content :global(strong) {
    font-weight: 700;
  }

  .post__content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-accent);
    background-color: var(--color-muted);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .post__related {
    max-width: var(--container-max);
    margin: 4rem auto 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .post__related-title {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .post__related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: stretch;
  }

  .post__related-grid > li {
    display: flex;
    height: 100%;
  }

  .post__related-grid > li > :global(*) {
    width: 100%;
  }

  .post__footer {
    max-width: 48rem;
    margin: 3rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .post__back {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .post__back:hover,
  .post__back:focus-visible {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .post__related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .post__related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
