---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SEO from '../../../../components/seo/SEO.astro';
import ArticleCard from '../../../../components/blog/ArticleCard.astro';
import BlogBreadcrumb from '../../../../components/blog/BlogBreadcrumb.astro';
import CategoryNav from '../../../../components/blog/CategoryNav.astro';
import PaginationNav from '../../../../components/blog/PaginationNav.astro';
import AdSlot from '../../../../components/ads/AdSlot.astro';
import JoinAdsScript from '../../../../components/ads/JoinAdsScript.astro';
import { getPublishedArticles } from '../../../../lib/blog';
import {
  ARTICLE_CATEGORIES,
  getCategoryPagePath,
  type ArticleCategorySlug,
} from '../../../../lib/categories';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getPublishedArticles();

  return ARTICLE_CATEGORIES.flatMap((category) => {
    const filtered = articles.filter((article) => article.data.category === category.value);

    return paginate(filtered, {
      pageSize: 12,
      params: { categoria: category.slug },
      props: {
        categorySlug: category.slug,
        categoryLabel: category.label,
      },
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: import('astro').Page<import('../../../../lib/blog').ArticleEntry>;
  categorySlug: ArticleCategorySlug;
  categoryLabel: string;
}

const { page, categorySlug, categoryLabel } = Astro.props;
const adAfterIndex = Math.min(2, Math.max(page.data.length - 1, 0));

const isPaginated = page.currentPage > 1;
const pageTitle = isPaginated
  ? `${categoryLabel} — página ${page.currentPage} | Blog | Instituto Recomeçar`
  : `${categoryLabel} | Blog | Instituto Recomeçar`;
const pageDescription = `Artigos da categoria ${categoryLabel} no blog do Instituto Recomeçar.`;
// Páginas 2+ ganham description própria para não duplicar a da primeira página.
const seoDescription = isPaginated
  ? `${pageDescription} Página ${page.currentPage} de ${page.lastPage}.`
  : pageDescription;
const canonicalPath = getCategoryPagePath(categorySlug, page.currentPage);
// Mesmos itens para o breadcrumb visual e para o BreadcrumbList do schema.
const breadcrumbItems = [
  { label: 'Início', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: categoryLabel, current: true },
];
---

<BaseLayout>
  <SEO
    slot="head"
    title={pageTitle}
    description={seoDescription}
    canonicalPath={canonicalPath}
    breadcrumbs={breadcrumbItems}
  />
  <JoinAdsScript slot="head" />

  <div class="blog-page">
    <BlogBreadcrumb items={breadcrumbItems} />

    <header class="blog-page__header">
      <p class="blog-page__eyebrow">Categoria</p>
      <h1 class="blog-page__title">{categoryLabel}</h1>
      <p class="blog-page__lead">{pageDescription}</p>
      <p class="blog-page__count">{page.total} artigos nesta categoria</p>
    </header>

    <CategoryNav activeCategorySlug={categorySlug} />

    {
      page.data.length > 0 ? (
        <>
          <ul class="blog-page__grid">
            {page.data.map((article, index) => (
              <>
                <li>
                  <ArticleCard article={article} />
                </li>
                {index === adAfterIndex && (
                  <li class="blog-page__ad">
                    <AdSlot code="Content2" />
                  </li>
                )}
              </>
            ))}
          </ul>
          <PaginationNav page={page} />
        </>
      ) : (
        <p class="blog-page__empty">Nenhum artigo publicado nesta categoria.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .blog-page {
    width: min(100% - 3rem, var(--container-max));
    margin-inline: auto;
    padding: 3rem 0 5rem;
  }

  .blog-page__header {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .blog-page__eyebrow {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .blog-page__title {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-primary);
  }

  .blog-page__lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted-text);
  }

  .blog-page__count,
  .blog-page__empty {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-muted-text);
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: stretch;
  }

  .blog-page__grid > li {
    display: flex;
    height: 100%;
  }

  .blog-page__grid > li > :global(*) {
    width: 100%;
  }

  .blog-page__ad {
    grid-column: 1 / -1;
    list-style: none;
    padding: 0.5rem 0 1rem;
  }

  @media (min-width: 768px) {
    .blog-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
