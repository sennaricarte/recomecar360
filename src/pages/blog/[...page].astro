---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/seo/SEO.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import BlogBreadcrumb from '../../components/blog/BlogBreadcrumb.astro';
import PaginationNav from '../../components/blog/PaginationNav.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import JoinAdsScript from '../../components/ads/JoinAdsScript.astro';
import { getPublishedArticles } from '../../lib/blog';
import { getBlogPagePath } from '../../lib/categories';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getPublishedArticles();
  return paginate(articles, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const adAfterIndex = Math.min(2, page.data.length - 1);

const isPaginated = page.currentPage > 1;
const pageTitle = isPaginated
  ? `Blog — página ${page.currentPage} | Instituto Recomeçar`
  : 'Blog | Instituto Recomeçar';
const pageDescription =
  'Artigos, notícias e conteúdos sobre ressocialização, empregabilidade, educação e impacto social do Instituto Recomeçar.';
// Páginas 2+ ganham description própria para não duplicar a da primeira página.
const seoDescription = isPaginated
  ? `${pageDescription} Página ${page.currentPage} de ${page.lastPage}.`
  : pageDescription;
const canonicalPath = getBlogPagePath(page.currentPage);
// Mesmos itens para o breadcrumb visual e para o BreadcrumbList do schema.
const breadcrumbItems = [
  { label: 'Início', href: '/' },
  { label: 'Blog', current: true },
];
---

<BaseLayout>
  <SEO
    slot="head"
    title={pageTitle}
    description={seoDescription}
    canonicalPath={canonicalPath}
    breadcrumbs={breadcrumbItems}
  />
  <JoinAdsScript slot="head" />

  <div class="blog-page">
    <BlogBreadcrumb items={breadcrumbItems} />

    <header class="blog-page__header">
      <p class="blog-page__eyebrow">Conteúdos</p>
      <h1 class="blog-page__title">Blog Recomeçar</h1>
      <p class="blog-page__lead">{pageDescription}</p>
      <p class="blog-page__count">{page.total} artigos publicados</p>
    </header>

    <ul class="blog-page__grid">
      {
        page.data.map((article, index) => (
          <>
            <li>
              <ArticleCard article={article} />
            </li>
            {page.data.length > 0 && index === adAfterIndex && (
              <li class="blog-page__ad">
                <AdSlot code="Content2" />
              </li>
            )}
          </>
        ))
      }
    </ul>

    <PaginationNav page={page} />
  </div>
</BaseLayout>

<style>
  .blog-page {
    width: min(100% - 3rem, var(--container-max));
    margin-inline: auto;
    padding: 3rem 0 5rem;
  }

  .blog-page__header {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .blog-page__eyebrow {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .blog-page__title {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-primary);
  }

  .blog-page__lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted-text);
  }

  .blog-page__count {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-muted-text);
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: stretch;
  }

  .blog-page__grid > li {
    display: flex;
    height: 100%;
  }

  .blog-page__grid > li > :global(*) {
    width: 100%;
  }

  .blog-page__ad {
    grid-column: 1 / -1;
    list-style: none;
    padding: 0.5rem 0 1rem;
  }

  @media (min-width: 768px) {
    .blog-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
