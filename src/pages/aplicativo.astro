---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/seo/SEO.astro';
import { SITE_URL } from '../lib/jsonld';
import appImage from '../assets/app-recomecar.png';

const pageTitle = 'Aplicativo | Instituto Recomeçar';
const pageDescription =
  'Baixe o aplicativo do Instituto Recomeçar e acesse vagas de emprego, cursos e oportunidades diretamente no seu celular.';
const canonicalPath = '/aplicativo/';
const appUrl = 'http://educacao360.cloud/';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Início',
      item: SITE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Aplicativo',
      item: new URL(canonicalPath, SITE_URL).href,
    },
  ],
};

const stats = [
  { value: '+13.000', label: 'Usuários cadastrados' },
  { value: '1.241', label: 'Inseridos no mercado' },
  { value: '2.400', label: 'Qualificados profissionalmente' },
  { value: '28', label: 'Empresas parceiras' },
];

const features = [
  {
    title: 'Academia Recomeçar',
    description:
      'Cursos completos de capacitação profissional com certificação, desde habilidades técnicas até soft skills essenciais para o mercado de trabalho.',
  },
  {
    title: 'Oportunidades de Emprego',
    description:
      'Vagas exclusivas em empresas parceiras do Instituto, com processo seletivo humanizado e acompanhamento na adaptação ao ambiente corporativo.',
  },
  {
    title: 'Criação de Currículo',
    description:
      'Ferramenta intuitiva para montar um currículo profissional direto pelo app, com modelos otimizados e orientações de preenchimento.',
  },
  {
    title: 'Trilha Personalizada',
    description:
      'Plano de desenvolvimento individual com etapas claras, metas e acompanhamento do progresso na jornada de reintegração.',
  },
  {
    title: 'Mentoria por Líderes',
    description:
      'Conexão com mentores e líderes sociais que oferecem orientação, apoio socioemocional e acompanhamento contínuo.',
  },
  {
    title: 'Cursos Parceiros',
    description:
      'Acesso a cursos de parceiros como Stone e outras empresas, ampliando as possibilidades de capacitação e empreendedorismo.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Cadastro',
    description: 'Crie sua conta de forma simples e rápida, informando seus dados básicos.',
  },
  {
    number: '02',
    title: 'Perfil',
    description: 'Complete seu perfil com habilidades, experiências e interesses profissionais.',
  },
  {
    number: '03',
    title: 'Trilha',
    description: 'Receba uma trilha personalizada de cursos e atividades para seu desenvolvimento.',
  },
  {
    number: '04',
    title: 'Oportunidades',
    description: 'Acesse vagas de emprego, cursos e mentorias disponíveis para você.',
  },
];

const impactCards = [
  {
    title: 'Apoio Socioemocional',
    description: 'Suporte contínuo durante toda a jornada',
  },
  {
    title: 'Dados Protegidos',
    description: 'Privacidade e segurança garantidas',
  },
  {
    title: 'Certificação',
    description: 'Certificados reconhecidos pelo mercado',
  },
];
---

<BaseLayout>
  <SEO
    slot="head"
    title={pageTitle}
    description={pageDescription}
    canonicalPath={canonicalPath}
    jsonLd={[breadcrumbJsonLd]}
  />

  <section class="hero" aria-label="Recomeçar 360">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <p class="hero__eyebrow">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect
              x="7"
              y="2"
              width="10"
              height="20"
              rx="2"
              stroke="currentColor"
              stroke-width="1.8"
            />
            <path d="M11 18h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          Aplicativo
        </p>
        <h1 class="hero__title">
          Recomeçar <span class="text-accent">360</span>
        </h1>
        <p class="hero__text">
          A plataforma digital que conecta egressos do sistema prisional a educação, emprego e
          oportunidades reais de transformação. Tudo na palma da mão.
        </p>
        <div class="hero__actions">
          <a
            href={appUrl}
            class="btn btn--accent"
            target="_blank"
            rel="noopener noreferrer"
          >
            Acessar agora
          </a>
          <a href="#funcionalidades" class="btn btn--ghost">Ver funcionalidades</a>
        </div>
      </div>

      <div class="hero__mockup reveal">
        <div class="phone">
          <Image
            src={appImage}
            alt="Tela do aplicativo Recomeçar 360"
            class="phone__screen"
            width={460}
            height={1024}
            loading="lazy"
            format="webp"
            quality="mid"
          />
        </div>
        <span class="badge badge--top">★ +13 mil usuários</span>
        <span class="badge badge--bottom">✓ 100% gratuito</span>
      </div>
    </div>

    <svg
      class="hero__wave"
      viewBox="0 0 1440 80"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z"
        fill="var(--color-bg)"
      ></path>
    </svg>
  </section>

  <section class="section" aria-label="Números do aplicativo">
    <div class="container">
      <ul class="stats">
        {
          stats.map((stat) => (
            <li class="stat-card reveal">
              <strong class="stat-card__value">{stat.value}</strong>
              <span class="stat-card__label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="funcionalidades" class="section section--muted" aria-label="Funcionalidades">
    <div class="container">
      <header class="section__header reveal">
        <p class="eyebrow">Funcionalidades</p>
        <h2 class="section__title">
          Tudo o que o egresso <span class="text-accent">precisa</span>
        </h2>
        <p class="section__lead">
          Uma plataforma completa para apoiar cada etapa da jornada de reintegração.
        </p>
      </header>

      <ul class="features">
        {
          features.map((feature) => (
            <li class="feature-card reveal">
              <span class="feature-card__icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 3 4 8v8l8 5 8-5V8l-8-5Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M12 12v9M4 8l8 4 8-4"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <h3 class="feature-card__title">{feature.title}</h3>
              <p class="feature-card__text">{feature.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-label="Como funciona">
    <div class="container">
      <header class="section__header reveal">
        <p class="eyebrow">Passo a Passo</p>
        <h2 class="section__title">Como funciona</h2>
        <p class="section__lead">
          Em poucos passos, o egresso tem acesso a um mundo de oportunidades.
        </p>
      </header>

      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step-card reveal">
              <span class="step-card__number" aria-hidden="true">
                {step.number}
              </span>
              <h3 class="step-card__title">{step.title}</h3>
              <p class="step-card__text">{step.description}</p>
              {index < steps.length - 1 && (
                <span class="step-card__arrow" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path
                      d="M9 6l6 6-6 6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--primary" aria-label="Impacto real">
    <div class="container section--primary__inner reveal">
      <p class="eyebrow eyebrow--light">Impacto Real</p>
      <h2 class="section__title section__title--light">
        Mais que um app, uma <span class="text-accent">ponte</span> para o futuro
      </h2>
      <p class="section__lead section__lead--light">
        O Recomeçar 360 já transformou a vida de milhares de pessoas, conectando egressos a cursos,
        empregos e uma rede de apoio que faz a diferença. Cada acesso é um passo a mais rumo à
        reintegração.
      </p>
      <ul class="impact-grid">
        {
          impactCards.map((card) => (
            <li class="impact-card">
              <h3 class="impact-card__title">{card.title}</h3>
              <p class="impact-card__text">{card.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--cta" aria-label="Comece sua transformação">
    <div class="container section--cta__inner reveal">
      <span class="cta-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
          <rect
            x="7"
            y="2"
            width="10"
            height="20"
            rx="2"
            stroke="currentColor"
            stroke-width="1.8"
          />
          <path d="M11 18h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </span>
      <h2 class="section__title">
        Comece sua <span class="text-accent">transformação</span> agora
      </h2>
      <p class="section__lead">
        Acesse o Recomeçar 360 e dê o primeiro passo rumo a um futuro com mais oportunidades,
        educação e dignidade.
      </p>
      <div class="hero__actions hero__actions--center">
        <a
          href={appUrl}
          class="btn btn--primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Acessar o Recomeçar 360
        </a>
        <a href="/" class="btn btn--outline">Voltar ao início</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .container {
    width: min(100% - 3rem, var(--container-max));
    margin-inline: auto;
  }

  .text-accent {
    color: var(--color-accent);
  }

  .section {
    padding: 5rem 0;
    background-color: var(--color-bg);
  }

  .section--muted {
    background-color: var(--color-muted);
  }

  .section--primary {
    background-color: var(--color-primary);
  }

  .section--primary__inner,
  .section--cta__inner {
    text-align: center;
  }

  .section__header {
    max-width: 42rem;
    margin-bottom: 2.5rem;
  }

  .section--primary .section__header,
  .section--cta .section__header {
    margin-inline: auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .eyebrow--light {
    color: var(--color-accent);
  }

  .section__title {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .section__title--light {
    color: var(--color-bg);
  }

  .section__lead {
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted-text);
  }

  .section--primary__inner .section__lead,
  .section--cta__inner .section__lead {
    margin-inline: auto;
  }

  .section__lead--light {
    color: rgb(255 255 255 / 88%);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    border: 2px solid transparent;
    transition: filter 0.15s ease;
  }

  .btn--accent {
    color: var(--color-accent-text);
    background-color: var(--color-accent);
  }

  .btn--primary {
    color: var(--color-bg);
    background-color: var(--color-primary);
  }

  .btn--ghost {
    color: var(--color-bg);
    border-color: rgb(255 255 255 / 70%);
    background-color: transparent;
  }

  .btn--outline {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background-color: transparent;
  }

  .btn:hover {
    filter: brightness(0.97);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .hero {
    position: relative;
    padding: 5rem 0 0;
    background: linear-gradient(
      145deg,
      var(--color-primary) 0%,
      var(--color-primary-hover) 100%
    );
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    padding-bottom: 4rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    margin-bottom: 1rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-bg);
  }

  .hero__text {
    max-width: 34rem;
    margin-bottom: 2rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 90%);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .hero__actions--center {
    justify-content: center;
  }

  .hero__mockup {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .phone {
    width: min(100%, 17rem);
    padding: 0.75rem;
    background-color: var(--color-muted);
    border: 6px solid color-mix(in srgb, var(--color-bg) 20%, var(--color-primary-hover));
    border-radius: 2.5rem;
    box-shadow: 0 24px 48px rgb(0 0 0 / 28%);
    overflow: hidden;
  }

  .phone__screen {
    width: 100%;
    height: auto;
    border-radius: 1.75rem;
  }

  .badge {
    position: absolute;
    z-index: 2;
    padding: 0.5rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 700;
    border-radius: 9999px;
    box-shadow: 0 8px 20px rgb(0 0 0 / 18%);
  }

  .badge--top {
    top: 1rem;
    right: 0;
    color: var(--color-accent-text);
    background-color: var(--color-accent);
  }

  .badge--bottom {
    bottom: 2rem;
    left: 0;
    color: var(--color-primary);
    background-color: var(--color-bg);
  }

  .hero__wave {
    display: block;
    width: 100%;
    height: 4rem;
  }

  .stats,
  .features,
  .steps,
  .impact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stat-card,
  .feature-card,
  .step-card,
  .impact-card {
    padding: 1.5rem;
    border-radius: var(--radius-md);
  }

  .stat-card {
    text-align: center;
    background-color: var(--color-muted);
    border: 1px solid var(--color-border);
  }

  .stat-card__value {
    display: block;
    margin-bottom: 0.35rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    color: var(--color-primary);
  }

  .stat-card__label {
    font-size: 0.9375rem;
    color: var(--color-muted-text);
  }

  .feature-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .feature-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary) 10%, var(--color-bg));
    border-radius: 9999px;
  }

  .feature-card__title,
  .step-card__title,
  .impact-card__title {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .feature-card__text,
  .step-card__text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted-text);
  }

  .step-card {
    position: relative;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .step-card__number {
    display: block;
    margin-bottom: 0.75rem;
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.18;
  }

  .step-card__arrow {
    display: none;
  }

  .impact-card {
    background-color: color-mix(in srgb, var(--color-bg) 10%, transparent);
    border: 1px solid rgb(255 255 255 / 14%);
  }

  .impact-card__title {
    color: var(--color-bg);
  }

  .impact-card__text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 85%);
  }

  .section--primary .section__title--light {
    margin-bottom: 1rem;
  }

  .section--primary .section__lead--light {
    margin-bottom: 2.5rem;
  }

  .cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
    background-color: var(--color-muted);
    border-radius: 9999px;
  }

  .reveal {
    /* Visível por padrão */
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @supports (animation-timeline: view()) {
    .reveal {
      animation: fadeUp 0.7s ease both;
      animation-timeline: view();
      animation-range: entry 0% cover 30%;
    }
  }

  @media (min-width: 768px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .features {
      grid-template-columns: repeat(2, 1fr);
    }

    .steps {
      grid-template-columns: repeat(4, 1fr);
    }

    .step-card__arrow {
      display: flex;
      position: absolute;
      top: 1.75rem;
      right: -0.85rem;
      z-index: 1;
      color: var(--color-primary);
      opacity: 0.45;
    }

    .impact-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }

    .features {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
