---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/seo/SEO.astro';
import { SITE_URL, faqPageJsonLd } from '../lib/jsonld';
import appImage from '../assets/app-recomecar.png';

const pageTitle = 'Oportunidades para Familiares | Instituto Recomeçar';
const pageDescription =
  'Familiares de egressos e pessoas privadas de liberdade: conheça oportunidades de emprego, cursos e programa Jovem Aprendiz.';
const canonicalPath = '/familiares/';

const faqItems = [
  {
    question: 'Quais os graus de parentesco que me permitem me inscrever?',
    answer: 'Filhos, primos, avós, netos, pais, irmãos, enteados, padrastos e madrastas.',
  },
  {
    question: 'Como faço para concorrer a vagas de emprego?',
    answer:
      'Preencha o cadastro. Sempre que houver vagas para a região em que você mora, iremos entrar em contato para informar as oportunidades.',
  },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Início',
      item: SITE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Familiares',
      item: new URL(canonicalPath, SITE_URL).href,
    },
  ],
};

const opportunities = [
  {
    title: 'Jovem Aprendiz',
    description:
      'Se você tem entre 14 e 24 anos, está cursando o ensino médio ou equivalente, e é filho ou filha de um egresso ou de uma pessoa privada de liberdade, essa oportunidade é para você!',
  },
  {
    title: 'Vagas de Emprego',
    description:
      'Se você é familiar de um egresso ou de uma pessoa privada de liberdade, e está em busca de um emprego, essa oportunidade é para você!',
  },
  {
    title: 'Cursos de Capacitação',
    description:
      'Se você é familiar de um egresso ou de uma pessoa privada de liberdade, e está em busca de melhorar sua qualificação profissional, essa oportunidade é para você!',
  },
];
---

<BaseLayout>
  <SEO
    slot="head"
    title={pageTitle}
    description={pageDescription}
    canonicalPath={canonicalPath}
    jsonLd={[breadcrumbJsonLd, faqPageJsonLd(faqItems)]}
  />

  <section class="hero" aria-label="Oportunidades para familiares">
    <div class="container hero__content reveal">
      <span class="hero__badge">Familiares</span>
      <h1 class="hero__title">Oportunidades para familiares</h1>
      <p class="hero__text">Familiares de egressos e pessoas privadas de liberdade!</p>
      <p class="hero__text hero__text--secondary">
        Queremos ajudá-los a reconstruir suas vidas e a criar um futuro melhor para seus familiares.
      </p>
      <a href="#cadastro" class="btn btn--accent">Cadastre-se para participar</a>
    </div>
  </section>

  <section class="section" aria-label="Oportunidades">
    <div class="container">
      <header class="section__header reveal">
        <p class="eyebrow">Oportunidades</p>
        <h2 class="section__title">Confira abaixo algumas das oportunidades</h2>
        <p class="section__lead">
          Lembrando que elas são somente para aqueles que têm familiares que são egressos do sistema
          prisional ou que estão privados de liberdade.
        </p>
      </header>

      <ul class="cards">
        {
          opportunities.map((item) => (
            <li class="card reveal">
              <span class="card__icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 3 4 8v8l8 5 8-5V8l-8-5Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M12 12v9M4 8l8 4 8-4"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <h3 class="card__title">{item.title}</h3>
              <p class="card__text">{item.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="cadastro" class="section section--muted" aria-label="Cadastre-se agora">
    <div class="container cta reveal">
      <span class="cta__icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 21s-6.7-4.3-9.3-8.1C1 10.4 1.4 7 4.2 5.5 6.3 4.4 8.7 5 12 8c3.3-3 5.7-3.6 7.8-2.5 2.8 1.5 3.2 4.9 1.5 7.4C18.7 16.7 12 21 12 21Z"
          />
        </svg>
      </span>
      <h2 class="section__title">Cadastre-se agora</h2>
      <p class="section__lead">
        Preencha seus dados para se inscrever e receber informações sobre as oportunidades
        disponíveis.
      </p>
      <a href="/contato" class="btn btn--primary">Entrar em contato</a>
    </div>
  </section>

  <section class="section section--app" aria-label="Aplicativo Recomeçar 360">
    <div class="container app">
      <div class="app__copy reveal">
        <span class="app__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
            <rect
              x="7"
              y="2"
              width="10"
              height="20"
              rx="2"
              stroke="currentColor"
              stroke-width="1.8"
            />
            <path d="M11 18h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </span>
        <h2 class="section__title section__title--light">Baixe o aplicativo Recomeçar 360</h2>
        <p class="section__lead section__lead--light">
          Com o app você acompanha oportunidades, recebe notificações de novas vagas e cursos, e tem
          acesso a conteúdos exclusivos para familiares. Tudo na palma da mão!
        </p>
        <a
          href="http://educacao360.cloud/"
          class="btn btn--accent"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 4v12M7 11l5 5 5-5M5 20h14"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          Acessar o aplicativo
        </a>
      </div>
      <div class="app__media reveal">
        <Image
          src={appImage}
          alt="Tela do aplicativo Recomeçar 360"
          class="app__image"
          width={460}
          height={1024}
          loading="lazy"
          format="webp"
          quality="mid"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-label="Principais dúvidas">
    <div class="container faq">
      <h2 class="section__title reveal">Principais dúvidas</h2>
      <div class="faq__list">
        {
          faqItems.map((item) => (
            <details class="faq__item reveal">
              <summary class="faq__question">
                <span>{item.question}</span>
                <svg
                  class="faq__chevron"
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M8 5l4 5-4 5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <p class="faq__answer">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .container {
    width: min(100% - 3rem, var(--container-max));
    margin-inline: auto;
  }

  .section {
    padding: 5rem 0;
    background-color: var(--color-bg);
  }

  .section--muted {
    background-color: var(--color-muted);
  }

  .section--app {
    background: linear-gradient(
      145deg,
      var(--color-primary) 0%,
      var(--color-primary-hover) 100%
    );
  }

  .section__header {
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .section__title {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .section__title--light {
    color: var(--color-bg);
  }

  .section__lead {
    max-width: 42rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted-text);
  }

  .section__lead--light {
    margin-bottom: 1.75rem;
    color: rgb(255 255 255 / 88%);
  }

  .hero {
    padding: 5rem 0;
    background: linear-gradient(
      145deg,
      var(--color-primary) 0%,
      var(--color-primary-hover) 100%
    );
  }

  .hero__content {
    max-width: 42rem;
  }

  .hero__badge {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.35rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    background-color: var(--color-accent);
    border-radius: 9999px;
  }

  .hero__title {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-bg);
  }

  .hero__text {
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-bg);
  }

  .hero__text--secondary {
    margin-bottom: 2rem;
    font-size: 1.0625rem;
    font-weight: 400;
    color: rgb(255 255 255 / 88%);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    border: 0;
    transition: filter 0.15s ease;
  }

  .btn--accent {
    color: var(--color-accent-text);
    background-color: var(--color-accent);
  }

  .btn--primary {
    color: var(--color-bg);
    background-color: var(--color-primary);
  }

  .btn:hover {
    filter: brightness(0.97);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .card {
    padding: 1.5rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
    background-color: var(--color-muted);
    border-radius: 9999px;
  }

  .card__title {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .card__text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted-text);
  }

  .cta {
    text-align: center;
  }

  .cta .section__lead {
    margin-inline: auto;
    margin-bottom: 1.75rem;
  }

  .cta__icon,
  .app__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 1rem;
    border-radius: 9999px;
  }

  .cta__icon {
    color: var(--color-primary);
    background-color: var(--color-bg);
  }

  .app {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .app__icon {
    color: var(--color-bg);
    background-color: color-mix(in srgb, var(--color-bg) 16%, transparent);
  }

  .app__media {
    display: flex;
    justify-content: center;
  }

  .app__image {
    width: min(100%, 12rem);
    height: auto;
    border-radius: 1.5rem;
    box-shadow: 0 24px 48px rgb(0 0 0 / 24%);
  }

  .faq {
    max-width: 48rem;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-muted);
    overflow: hidden;
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__chevron {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(90deg);
  }

  .faq__answer {
    padding: 0 1.25rem 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted-text);
  }

  .reveal {
    /* Visível por padrão */
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @supports (animation-timeline: view()) {
    .reveal {
      animation: fadeUp 0.7s ease both;
      animation-timeline: view();
      animation-range: entry 0% cover 30%;
    }
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }

    .app {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .app__image {
      width: min(100%, 16rem);
    }
  }
</style>
