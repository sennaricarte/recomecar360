---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/seo/SEO.astro';
import BlogBreadcrumb from '../components/blog/BlogBreadcrumb.astro';
import PartnerForm from '../components/forms/PartnerForm.astro';

const pageTitle = 'Quero ser Parceiro | Instituto Recomeçar';
const pageDescription =
  'Empresas e organizações podem se tornar parceiras do Instituto Recomeçar em projetos de ESG, empregabilidade e impacto social.';
---

<BaseLayout>
  <SEO
    slot="head"
    title={pageTitle}
    description={pageDescription}
    canonicalPath="/quero-ser-parceiro/"
    breadcrumbs={[{ label: 'Quero ser Parceiro' }]}
  />

  <div class="page">
    <BlogBreadcrumb
      items={[
        { label: 'Início', href: '/' },
        { label: 'Quero ser Parceiro', current: true },
      ]}
    />

    <header class="page__header">
      <p class="page__eyebrow">Parcerias</p>
      <h1 class="page__title">Quero ser Parceiro</h1>
      <p class="page__lead">
        Empresas e organizações que desejam contribuir com a ressocialização de egressos podem
        firmar parcerias de empregabilidade, capacitação, doação direcionada ou projetos de ESG.
        Conte-nos sobre sua proposta.
      </p>
    </header>

    <div class="form-panel">
      <PartnerForm />
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    width: min(100% - 3rem, 48rem);
    margin-inline: auto;
    padding: 3rem 0 5rem;
  }

  .page__header {
    margin-bottom: 2rem;
  }

  .page__eyebrow {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .page__title {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-primary);
  }

  .page__lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted-text);
  }

  .form-panel {
    padding: 1.5rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
</style>
