---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/seo/SEO.astro';
import BlogBreadcrumb from '../../components/blog/BlogBreadcrumb.astro';
import { getInitials } from '../../lib/team';

const colunistas = (await getCollection('colunistas')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);

const pageTitle = 'Colunistas | Instituto Recomeçar';
const pageDescription =
  'Conheça os colunistas do Instituto Recomeçar e leia reflexões sobre ressocialização, inclusão e transformação social.';
const breadcrumbItems = [
  { label: 'Início', href: '/' },
  { label: 'Colunistas', current: true },
];
---

<BaseLayout>
  <SEO
    slot="head"
    title={pageTitle}
    description={pageDescription}
    canonicalPath="/colunistas/"
    breadcrumbs={breadcrumbItems}
  />

  <div class="columnists-page">
    <BlogBreadcrumb items={breadcrumbItems} />

    <header class="columnists-page__header">
      <p class="columnists-page__eyebrow">Opinião e reflexão</p>
      <h1 class="columnists-page__title">Colunistas</h1>
      <p class="columnists-page__lead">
        Vozes que contribuem com análises, experiências e perspectivas sobre reintegração social,
        direitos humanos e impacto comunitário.
      </p>
    </header>

    <ul class="columnists-page__grid">
      {
        colunistas.map((colunista, index) => (
          <li>
            <a href={`/colunistas/${colunista.data.slug}/`} class="columnist-card">
              <span
                class:list={[
                  'columnist-card__avatar',
                  index % 2 === 0 ? 'columnist-card__avatar--primary' : 'columnist-card__avatar--accent',
                ]}
                aria-hidden="true"
              >
                {getInitials(colunista.data.name)}
              </span>
              <div class="columnist-card__body">
                <h2 class="columnist-card__name">{colunista.data.name}</h2>
                <p class="columnist-card__column">{colunista.data.columnName}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .columnists-page {
    width: min(100% - 3rem, var(--container-max));
    margin-inline: auto;
    padding: 3rem 0 5rem;
  }

  .columnists-page__header {
    max-width: 42rem;
    margin-bottom: 2.5rem;
  }

  .columnists-page__eyebrow {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .columnists-page__title {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-primary);
  }

  .columnists-page__lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted-text);
  }

  .columnists-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .columnist-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .columnist-card:hover,
  .columnist-card:focus-visible {
    border-color: var(--color-primary);
    box-shadow: 0 4px 16px rgb(63 62 64 / 8%);
    outline: none;
  }

  .columnist-card__avatar {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    font-size: 1.125rem;
    font-weight: 700;
    border-radius: 9999px;
  }

  .columnist-card__avatar--primary {
    color: var(--color-bg);
    background-color: var(--color-primary);
  }

  .columnist-card__avatar--accent {
    color: var(--color-accent-text);
    background-color: var(--color-accent);
  }

  .columnist-card__name {
    margin-bottom: 0.25rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .columnist-card__column {
    font-size: 0.875rem;
    color: var(--color-muted-text);
  }

  @media (min-width: 768px) {
    .columnists-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .columnists-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
