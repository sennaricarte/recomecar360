---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body class="font-body text-text bg-bg antialiased">
    <a
      href="#main-content"
      class="absolute left-4 top-4 z-50 -translate-y-16 rounded-sm bg-primary px-4 py-2 text-sm font-medium text-white transition focus:translate-y-0 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
    >
      Pular para o conteúdo principal
    </a>
    <div class="layout-shell">
      <Header />
      <main id="main-content" class="layout-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .layout-shell {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .layout-main {
    flex: 1;
  }
</style>
