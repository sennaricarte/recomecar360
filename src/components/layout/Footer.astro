---
import { Image } from 'astro:assets';
import logoImage from '../../assets/logo-recomecar.png';

const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/blog', label: 'Blog' },
  { href: '/quem-somos', label: 'Quem Somos' },
  { href: '/conselho', label: 'Conselho Construtivo' },
  { href: '/diretoria', label: 'Diretoria Executiva' },
  { href: '/embaixadores', label: 'Embaixadores' },
  { href: '/para-estudantes', label: 'Para Estudantes' },
  { href: '/contato', label: 'Contato' },
];

const legalLinks = [
  { href: '/politica-de-privacidade', label: 'Política de Privacidade' },
  { href: '/termos-de-uso', label: 'Termos de Uso' },
];

const socialLinks = [
  {
    href: 'https://www.instagram.com/recomecar360',
    label: 'Instagram do Instituto Recomeçar',
  },
  {
    href: 'https://www.linkedin.com/company/instituto-recomecar/?originalSubdomain=br',
    label: 'LinkedIn do Instituto Recomeçar',
  },
  {
    href: 'https://www.facebook.com/recomecargf',
    label: 'Facebook do Instituto Recomeçar',
  },
  {
    href: 'https://www.youtube.com/@Recomecar360',
    label: 'YouTube do Instituto Recomeçar',
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label="Instituto Recomeçar — página inicial">
          <Image
            src={logoImage}
            alt="Instituto Recomeçar"
            width={512}
            height={484}
            format="webp"
            quality="mid"
            class="footer-logo"
          />
        </a>
        <p class="footer-text">
          Organização de impacto social que reduz a reincidência criminal e gera
          segurança pública para as cidades brasileiras. Metodologia própria,
          ROI comprovado.
        </p>
        <ul class="social-list" aria-label="Redes sociais">
          <li>
            <a
              href={socialLinks[0].href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLinks[0].label}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M12 7.2a4.8 4.8 0 1 0 0 9.6 4.8 4.8 0 0 0 0-9.6zm0-2.4c3.3 0 3.7 0 5 .1 1.2.1 1.9.3 2.3.5.6.2 1 .5 1.5 1 .4.4.7.9 1 1.5.2.4.4 1.1.5 2.3.1 1.3.1 1.7.1 5s0 3.7-.1 5c-.1 1.2-.3 1.9-.5 2.3-.2.6-.5 1-1 1.5-.4.4-.9.7-1.5 1-.4.2-1.1.4-2.3.5-1.3.1-1.7.1-5 .1s-3.7 0-5-.1c-1.2-.1-1.9-.3-2.3-.5-.6-.2-1-.5-1.5-1-.4-.4-.7-.9-1-1.5-.2-.4-.4-1.1-.5-2.3-.1-1.3-.1-1.7-.1-5s0-3.7.1-5c.1-1.2.3-1.9.5-2.3.2-.6.5-1 1-1.5.4-.4.9-.7 1.5-1 .4-.2 1.1-.4 2.3-.5 1.3-.1 1.7-.1 5-.1zm0-2.4C8.7 2.4 8.3 2.4 7 2.5 5.7 2.6 4.8 2.9 4 3.3c-.8.4-1.5.9-2.1 1.5-.6.6-1.1 1.3-1.5 2.1-.4.8-.7 1.7-.8 3-.1 1.3-.1 1.7-.1 5s0 3.7.1 5c.1 1.3.4 2.2.8 3 .4.8.9 1.5 1.5 2.1.6.6 1.3 1.1 2.1 1.5.8.4 1.7.7 3 .8 1.3.1 1.7.1 5 .1s3.7 0 5-.1c1.3-.1 2.2-.4 3-.8.8-.4 1.5-.9 2.1-1.5.6-.6 1.1-1.3 1.5-2.1.4-.8.7-1.7.8-3 .1-1.3.1-1.7.1-5s0-3.7-.1-5c-.1-1.3-.4-2.2-.8-3-.4-.8-.9-1.5-1.5-2.1-.6-.6-1.3-1.1-2.1-1.5-.8-.4-1.7-.7-3-.8-1.3-.1-1.7-.1-5-.1z"
                ></path>
                <path d="M18.4 6.6a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2z"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={socialLinks[1].href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLinks[1].label}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V24h-4V8zm7.5 0h3.8v2.2h.1c.5-1 1.8-2.2 3.8-2.2 4 0 4.7 2.6 4.7 6.1V24h-4v-7.1c0-1.7 0-3.8-2.3-3.8-2.3 0-2.7 1.8-2.7 3.7V24h-4V8z"
                ></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={socialLinks[2].href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLinks[2].label}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M22 12a10 10 0 1 0-11.6 9.9v-7h-2.3V12h2.3V9.8c0-2.3 1.4-3.6 3.5-3.6 1 0 2 .2 2 .2v2.2h-1.1c-1.1 0-1.4.7-1.4 1.4V12h2.4l-.4 2.9h-2V21A10 10 0 0 0 22 12z"
                ></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={socialLinks[3].href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLinks[3].label}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.5 12 3.5 12 3.5s-7.6 0-9.4.6A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.8.6 9.4.6 9.4.6s7.6 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.6 15.5V8.5L15.8 12l-6.2 3.5z"
                ></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <nav class="footer-nav" aria-label="Navegação do rodapé">
        <h2 class="footer-heading">Navegação</h2>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer-legal" aria-label="Links legais">
        <h2 class="footer-heading">Legal</h2>
        <ul>
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="footer-copy">
      &copy; {currentYear} Instituto Recomeçar. Todos os direitos reservados.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .footer-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 3rem 1.5rem 1.5rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    height: 3rem;
    width: auto;
  }

  .footer-text {
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 88%);
  }

  .social-list {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social-list a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: #ffffff;
    background-color: rgb(255 255 255 / 12%);
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease;
  }

  .social-list a:hover,
  .social-list a:focus-visible {
    background-color: rgb(255 255 255 / 22%);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .footer-heading {
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .footer-nav ul,
  .footer-legal ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a,
  .footer-legal a {
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 88%);
    text-decoration: none;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible,
  .footer-legal a:hover,
  .footer-legal a:focus-visible {
    color: #ffffff;
    text-decoration: underline;
    outline: none;
  }

  .footer-copy {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 18%);
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 72%);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }

    .footer-brand {
      grid-column: span 2;
    }

    .footer-copy {
      text-align: left;
    }
  }
</style>
