---
import { Image } from 'astro:assets';
import logoImage from '../../assets/logo-recomecar-footer.png';
import seloMapaOsc from '../../assets/selo-mapa-osc.png';

const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/blog', label: 'Blog' },
  { href: '/quem-somos', label: 'Quem Somos' },
  { href: '/conselho', label: 'Conselho Construtivo' },
  { href: '/diretoria', label: 'Diretoria Executiva' },
  { href: '/embaixadores', label: 'Embaixadores' },
  { href: '/para-estudantes', label: 'Para Estudantes' },
  { href: '/contato', label: 'Contato' },
];

const legalLinks = [
  { href: '/politica-de-privacidade', label: 'Política de Privacidade' },
  { href: '/termos-de-uso', label: 'Termos de Uso' },
];

const socialLinks = [
  {
    href: 'https://www.instagram.com/recomecar360',
    label: 'Instagram do Instituto Recomeçar',
  },
  {
    href: 'https://www.linkedin.com/company/instituto-recomecar/?originalSubdomain=br',
    label: 'LinkedIn do Instituto Recomeçar',
  },
  {
    href: 'https://www.facebook.com/recomecargf',
    label: 'Facebook do Instituto Recomeçar',
  },
  {
    href: 'https://www.youtube.com/@Recomecar360',
    label: 'YouTube do Instituto Recomeçar',
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo-link" aria-label="Instituto Recomeçar — página inicial">
          <Image
            src={logoImage}
            alt="Instituto Recomeçar"
            width={1024}
            height={969}
            format="webp"
            quality="mid"
            class="footer-logo"
          />
        </a>
        <p class="footer-text">
          Organização de impacto social que reduz a reincidência criminal e gera
          segurança pública para as cidades brasileiras. Metodologia própria,
          retorno social estimado.
        </p>
        <ul class="social-list" aria-label="Redes sociais">
          <li>
            <a
              href={socialLinks[0].href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLinks[0].label}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={socialLinks[1].href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLinks[1].label}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={socialLinks[2].href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLinks[2].label}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={socialLinks[3].href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLinks[3].label}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <nav class="footer-nav" aria-label="Navegação do rodapé">
        <h2 class="footer-heading">Navegação</h2>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer-legal" aria-label="Links legais">
        <h2 class="footer-heading">Legal</h2>
        <ul>
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} Instituto Recomeçar. Todos os direitos reservados.
      </p>
      <a
        class="footer-selo"
        href="https://mapaosc.ipea.gov.br/selo-osc/1324775"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Selo OSC no Mapa das Organizações da Sociedade Civil — IPEA"
      >
        <Image
          src={seloMapaOsc}
          alt="Selo OSC — Mapa das Organizações da Sociedade Civil (IPEA)"
          width={361}
          height={100}
          format="webp"
          quality="mid"
          loading="lazy"
          class="footer-selo__img"
        />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .footer-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 3rem 1.5rem 2.5rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo-link {
    display: inline-block;
    line-height: 0;
    overflow: visible;
    max-width: 100%;
  }

  .footer-logo {
    display: block;
    width: 10rem;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .footer-text {
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 88%);
  }

  .social-list {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social-list a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: #ffffff;
    background-color: rgb(255 255 255 / 12%);
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease;
  }

  .social-list a:hover,
  .social-list a:focus-visible {
    background-color: rgb(255 255 255 / 22%);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .footer-heading {
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .footer-nav ul,
  .footer-legal ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a,
  .footer-legal a {
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 88%);
    text-decoration: none;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible,
  .footer-legal a:hover,
  .footer-legal a:focus-visible {
    color: #ffffff;
    text-decoration: underline;
    outline: none;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 18%);
  }

  .footer-copy {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 72%);
    text-align: center;
  }

  .footer-selo {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 0;
    overflow: visible;
    border-radius: var(--radius-sm);
    background-color: #ffffff;
    padding: 0.625rem 0.875rem;
    transition: opacity 0.15s ease;
  }

  .footer-selo:hover,
  .footer-selo:focus-visible {
    opacity: 0.92;
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .footer-selo__img {
    display: block;
    width: min(100%, 14rem);
    max-width: 14rem;
    height: auto;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }

    .footer-brand {
      grid-column: span 2;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .footer-copy {
      text-align: left;
    }
  }
</style>
