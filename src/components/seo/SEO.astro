---
import { SITE_URL, breadcrumbJsonLd, type BreadcrumbInput } from '../../lib/jsonld';
import { normalizeDescription, toPlainText } from '../../lib/seo';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  /** Trilha de navegação; gera o BreadcrumbList. Use os mesmos itens do breadcrumb visual. */
  breadcrumbs?: BreadcrumbInput[];
}

const {
  title: rawTitle,
  description: rawDescription,
  canonicalPath,
  ogImage = '/images/og-default.png',
  jsonLd: extraJsonLd = [],
  breadcrumbs,
} = Astro.props;

const jsonLd = breadcrumbs?.length
  ? [...extraJsonLd, breadcrumbJsonLd(breadcrumbs, canonicalPath)]
  : extraJsonLd;

// Rede de segurança para todas as páginas: sem tags/entidades e com tamanho de snippet.
const title = toPlainText(rawTitle);
const description = normalizeDescription(rawDescription);

const canonicalUrl = new URL(canonicalPath, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

function serializeJsonLd(data: Record<string, unknown>): string {
  return JSON.stringify(data).replace(/</g, '\\u003c');
}
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Instituto Recomeçar" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{
  jsonLd.map((item) => (
    <script type="application/ld+json" set:html={serializeJsonLd(item)} />
  ))
}
